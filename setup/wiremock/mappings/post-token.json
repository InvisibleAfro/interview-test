{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "jsonBody": {
      "access_token": "mock-jwt-token-for-interview",
      "token_type": "bearer",
      "expires_in": 7200
    }
  }
}
